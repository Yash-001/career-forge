# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection — host port 5433 maps to container port 5432
DATABASE_URL=jdbc:postgresql://localhost:5433/careerforge
DATABASE_USERNAME=careerforge
DATABASE_PASSWORD=careerforge

# ── JWT ───────────────────────────────────────────────────────────────────────
# REQUIRED: Replace with a securely generated secret of at least 256 bits (32+ chars).
# Generate with: openssl rand -base64 64
JWT_SECRET=replace-this-with-a-secure-random-secret-at-least-256-bits-long
# Access token lifetime in milliseconds (default: 15 minutes)
JWT_ACCESS_EXPIRATION=900000
# Refresh token lifetime in milliseconds (default: 7 days)
JWT_REFRESH_EXPIRATION=604800000

# ── Email Provider ────────────────────────────────────────────────────────────
# Supported: console (default — logs reset links to stdout)
EMAIL_PROVIDER=console

# ── Demo Mode ─────────────────────────────────────────────────────────────────
# Set to true ONLY for local portfolio demonstration. Never enable in production.
# When true: seeds demo user on startup, enables POST /api/v1/demo/login.
CAREERFORGE_DEMO_MODE=false

# Environment identifier — set to "production" on live deployments.
# The application will refuse to start if CAREERFORGE_DEMO_MODE=true AND CAREERFORGE_ENV=production.
CAREERFORGE_ENV=

# Demo user credentials — only used when CAREERFORGE_DEMO_MODE=true.
# Change these before deploying a public demo. Never commit real values.
DEMO_USER_EMAIL=demo@careerforge.dev
DEMO_USER_PASSWORD=Demo1234!

# ── Billing Provider ─────────────────────────────────────────────────────────
# Supported: demo (default — no credentials needed), stripe
BILLING_PROVIDER=demo

# ── Stripe (test-mode only) ───────────────────────────────────────────────────
# Required only when BILLING_PROVIDER=stripe. Leave blank for demo mode.
# NEVER use live (sk_live_...) keys. Test keys only (sk_test_...).
# Get test keys from: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_replace_with_your_test_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_webhook_secret
STRIPE_PRICE_PRO_MONTHLY=price_replace_with_your_pro_monthly_price_id

# ── Frontend ──────────────────────────────────────────────────────────────────
# Override the backend API base URL if not running on the default port
VITE_API_BASE_URL=http://localhost:8080/api/v1
